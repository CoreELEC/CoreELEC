From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Wed, 30 Sep 2026 12:00:00 +0200
Subject: [PATCH] sunxi: h616: Select the integrated EPHY from the SID

Depending on the silicon variant, EMAC1 on H616, H618 and H313 is wired
to an AC200 or an AC300 EPHY. Which one is present is recorded in bit 8
of the EPHY configuration word in the SID.

Add an option for boards which use the integrated EPHY. On those, the
kernel DT describes the AC200 EPHY and a disabled AC300 EPHY package.
If the SID reports an AC300, enable the package, point EMAC1 to its PHY
and disable the AC200 nodes. Enable it on X96 Mate, X96Q and Transpeed
8K618-T.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 arch/arm/mach-sunxi/Kconfig         | 10 +++++
 board/sunxi/board.c                 | 65 +++++++++++++++++++++++++++++
 configs/transpeed-8k618-t_defconfig |  1 +
 configs/x96_mate_defconfig          |  1 +
 configs/x96q_defconfig              |  1 +
 5 files changed, 78 insertions(+)

diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
index a79a1ee54423..d973459c0937 100644
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -1230,6 +1230,16 @@ config BLUETOOTH_DT_DEVICE_FIXUP
 	  The used address is "bdaddr" if set, and "ethaddr" with the LSB
 	  flipped elsewise.
 
+config SUNXI_H616_INTERNAL_EPHY
+	bool "Board uses the H616 integrated EPHY"
+	depends on MACH_SUN50I_H616
+	help
+	  Depending on the silicon variant, the H616 family integrates either
+	  an AC200 or an AC300 Ethernet PHY on EMAC1. Select this if the board
+	  uses it. The kernel device tree then describes the AC200 EPHY and a
+	  disabled AC300 EPHY package, and U-Boot switches to the latter when
+	  the SID reports an AC300.
+
 config CHIP_DIP_SCAN
 	bool "Enable DIPs detection for CHIP board"
 	select SUPPORT_EXTENSION_SCAN
diff --git a/board/sunxi/board.c b/board/sunxi/board.c
index 3d1afec7c669..a79fbbdcdc92 100644
--- a/board/sunxi/board.c
+++ b/board/sunxi/board.c
@@ -928,6 +928,70 @@ static void board_dt_fixup(void *blob)
 	}
 }
 
+#define SUN50I_H616_SID_EPHY_CFG	0x2c
+#define SUN50I_H616_EPHY_CFG_AC300	BIT(8)
+
+/*
+ * EMAC1 on H616 is wired to an AC200 or an AC300 EPHY, depending on the
+ * silicon variant. The DT describes the AC200 one and a disabled AC300
+ * PHY package. Switch to the latter if the SID says an AC300 is present.
+ */
+static void sunxi_h616_ephy_fixup(void *blob)
+{
+	const fdt32_t *handle;
+	int emac, node, ret;
+	u32 phandle;
+
+	if (!IS_ENABLED(CONFIG_SUNXI_H616_INTERNAL_EPHY))
+		return;
+
+	if (!(readl(SUNXI_SID_BASE + SUN50I_H616_SID_EPHY_CFG) &
+	      SUN50I_H616_EPHY_CFG_AC300))
+		return;
+
+	node = fdt_node_offset_by_compatible(blob, -1,
+					     "x-powers,ac300-ephy-package");
+	if (node >= 0)
+		node = fdt_first_subnode(blob, node);
+	if (node < 0) {
+		printf("AC300 EPHY is not described in DT\n");
+		return;
+	}
+
+	phandle = fdt_create_phandle(blob, node);
+	if (!phandle)
+		return;
+
+	/* Disable the AC200 EPHY and point EMAC1 to the AC300 one. */
+	emac = fdt_node_offset_by_compatible(blob, -1,
+					     "allwinner,sun50i-h616-emac1");
+	if (emac < 0)
+		return;
+
+	handle = fdt_getprop(blob, emac, "phy-handle", NULL);
+	if (handle) {
+		node = fdt_node_offset_by_phandle(blob, fdt32_to_cpu(*handle));
+		if (node >= 0)
+			fdt_status_disabled(blob, node);
+	}
+
+	/* Offsets change with every update, so look EMAC1 up again. */
+	emac = fdt_node_offset_by_compatible(blob, -1,
+					     "allwinner,sun50i-h616-emac1");
+	ret = fdt_setprop_u32(blob, emac, "phy-handle", phandle);
+	if (ret) {
+		printf("Failed to select AC300 EPHY: %s\n", fdt_strerror(ret));
+		return;
+	}
+
+	fdt_status_okay_by_compatible(blob, "x-powers,ac300-ephy-package");
+
+	/* These SoCs have no AC200 at all. */
+	fdt_status_disabled_by_compatible(blob, "x-powers,ac200");
+
+	printf("EPHY:  AC300\n");
+}
+
 int ft_board_setup(void *blob, struct bd_info *bd)
 {
 	int __maybe_unused r;
@@ -941,6 +1005,7 @@ int ft_board_setup(void *blob, struct bd_info *bd)
 	fdt_fixup_ethernet(blob);
 
 	bluetooth_dt_fixup(blob);
+	sunxi_h616_ephy_fixup(blob);
 	board_dt_fixup(blob);
 
 #ifdef CONFIG_VIDEO_DT_SIMPLEFB
diff --git a/configs/transpeed-8k618-t_defconfig b/configs/transpeed-8k618-t_defconfig
index e672d8f8df9a..c174e866ade5 100644
--- a/configs/transpeed-8k618-t_defconfig
+++ b/configs/transpeed-8k618-t_defconfig
@@ -12,6 +12,7 @@ CONFIG_DRAM_SUNXI_TPR10=0x2f1107
 CONFIG_DRAM_SUNXI_TPR11=0xddddcccc
 CONFIG_DRAM_SUNXI_TPR12=0xeddc7665
 CONFIG_MACH_SUN50I_H616=y
+CONFIG_SUNXI_H616_INTERNAL_EPHY=y
 CONFIG_SUNXI_DRAM_H616_DDR3_1333=y
 CONFIG_MMC_SUNXI_SLOT_EXTRA=2
 CONFIG_R_I2C_ENABLE=y
diff --git a/configs/x96_mate_defconfig b/configs/x96_mate_defconfig
index 1b7d9338c023..f7ce93ea1169 100644
--- a/configs/x96_mate_defconfig
+++ b/configs/x96_mate_defconfig
@@ -11,6 +11,7 @@ CONFIG_DRAM_SUNXI_TPR10=0x2f0007
 CONFIG_DRAM_SUNXI_TPR11=0xffffdddd
 CONFIG_DRAM_SUNXI_TPR12=0xfedf7557
 CONFIG_MACH_SUN50I_H616=y
+CONFIG_SUNXI_H616_INTERNAL_EPHY=y
 CONFIG_SUNXI_DRAM_H616_DDR3_1333=y
 CONFIG_MMC_SUNXI_SLOT_EXTRA=2
 CONFIG_R_I2C_ENABLE=y
diff --git a/configs/x96q_defconfig b/configs/x96q_defconfig
index 068aee3fd1ea..ef422012b1c3 100644
--- a/configs/x96q_defconfig
+++ b/configs/x96q_defconfig
@@ -13,6 +13,7 @@ CONFIG_DRAM_SUNXI_TPR10=0x002f0107
 CONFIG_DRAM_SUNXI_TPR11=0xddddcccc
 CONFIG_DRAM_SUNXI_TPR12=0xeddc7665
 CONFIG_MACH_SUN50I_H616=y
+CONFIG_SUNXI_H616_INTERNAL_EPHY=y
 CONFIG_SUNXI_DRAM_H616_DDR3_1333=y
 CONFIG_MMC_SUNXI_SLOT_EXTRA=2
 CONFIG_R_I2C_ENABLE=y
