+static int sun4i_i2s_hdmi_pcm_process(struct snd_pcm_substream *substream,
+				      int channel, unsigned long hwoff,
+				      unsigned long bytes)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	__le32 *ptr = (__le32 *)(runtime->dma_area + hwoff +
+		channel * (runtime->dma_bytes / runtime->channels));
+	__le32 *end = (__le32 *)((u8 *)ptr + bytes);
+
+	if (runtime->format != SNDRV_PCM_FORMAT_IEC958_SUBFRAME_LE)
+		return 0;
+
+	if (!sun4i_i2s_is_hdmi(substream))
+		return -EINVAL;
+
+	if (bytes % sizeof(*ptr))
+		return -EINVAL;
+
+	for (; ptr < end; ptr++) {
+		u32 sample = le32_to_cpu(*ptr);
+		u32 hdmi = (sample & SUN4I_I2S_HDMI_PAYLOAD_MASK) >> 1;
+
+		/* Move P, C, U and V from bits 31:28 to bits 30:27. */
+		hdmi |= (sample & SUN4I_I2S_HDMI_PCUV_MASK) >> 1;
+
+		/* ALSA's Z preamble marks the first frame of an IEC958 block. */
+		if ((sample & IEC958_SUBFRAME_PREAMBLE_MASK) ==
+		    SUN4I_I2S_HDMI_PREAMBLE_B)
+			hdmi |= BIT(31);
+
+		*ptr = cpu_to_le32(hdmi);
+	}
+
+	return 0;
+}
