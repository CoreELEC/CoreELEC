+static void ac200_codec_disable(void *data)
+{
+	struct ac200_codec *priv = data;
+
+	regmap_write(priv->regmap, AC200_SYS_AUDIO_CTL1, 0);
+	regmap_write(priv->regmap, AC200_SYS_AUDIO_CTL0, 0);
+}
+
+static int ac200_codec_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct ac200_codec *priv;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->regmap = dev_get_regmap(dev->parent, NULL);
+	if (!priv->regmap)
+		return dev_err_probe(dev, -ENODEV, "Parent has no regmap\n");
+
+	platform_set_drvdata(pdev, priv);
+
+	ret = regmap_write(priv->regmap, AC200_SYS_AUDIO_CTL0,
+			   AC200_SYS_AUDIO_CTL0_RST_INVALID |
+			   AC200_SYS_AUDIO_CTL0_MCLK_GATING);
+	if (ret)
+		return ret;
+
+	ret = devm_add_action_or_reset(dev, ac200_codec_disable, priv);
+	if (ret)
+		return ret;
+
+	/*
+	 * Register the cleanup before touching the second control register, so
+	 * that a later error cannot leave the audio block's clock running.
+	 * Registering the component afterwards also ensures devres unwinding
+	 * unregisters it before gating the clock and asserting reset.
+	 */
+	ret = regmap_write(priv->regmap, AC200_SYS_AUDIO_CTL1,
+			   AC200_SYS_AUDIO_CTL1_I2S_IO_EN);
+	if (ret)
+		return ret;
+
+	/*
+	 * Match the vendor-selected 524ms anti-pop and slope times. Without
+	 * this the output stage snaps on and off and the result is audible.
+	 */
+	ret = regmap_update_bits(priv->regmap, AC200_LINEOUT_CTL,
+				 AC200_LINEOUT_CTL_SLOPE_MASK |
+				 AC200_LINEOUT_CTL_ANTIPOP_MASK,
+				 AC200_LINEOUT_CTL_SLOPE(3) |
+				 AC200_LINEOUT_CTL_ANTIPOP(3));
+	if (ret)
+		return ret;
+
+	/*
+	 * Hold ADC data back for 30ms after the ADC is enabled, so that the
+	 * settling of the analog front end does not end up in the stream.
+	 */
+	ret = regmap_update_bits(priv->regmap, AC200_ADC_CTL,
+				 AC200_ADC_CTL_DELAY_TIME_MASK |
+				 AC200_ADC_CTL_DELAY_EN,
+				 AC200_ADC_CTL_DELAY_TIME(3) |
+				 AC200_ADC_CTL_DELAY_EN);
+	if (ret)
+		return ret;
+
+	ret = devm_snd_soc_register_component(dev, &ac200_soc_component,
+					      &ac200_codec_dai, 1);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to register codec\n");
+
+	return 0;
+}
+
+static const struct of_device_id ac200_codec_match[] = {
+	{ .compatible = "x-powers,ac200-codec" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ac200_codec_match);
+
+static struct platform_driver ac200_codec_driver = {
+	.driver = {
+		.name = "ac200-codec",
+		.of_match_table = ac200_codec_match,
+	},
+	.probe = ac200_codec_probe,
+};
+module_platform_driver(ac200_codec_driver);
+
+MODULE_DESCRIPTION("X-Powers AC200 Codec Driver");
+MODULE_AUTHOR("Jernej Skrabec <jernej.skrabec@gmail.com>");
+MODULE_LICENSE("GPL");
