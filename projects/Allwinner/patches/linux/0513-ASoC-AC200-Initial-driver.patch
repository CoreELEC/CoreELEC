+static int ac200_get_sr_sw(unsigned int width)
+{
+	switch (width) {
+	case 8:
+		return 1;
+	case 12:
+		return 2;
+	case 16:
+		return 3;
+	case 20:
+		return 4;
+	case 24:
+		return 5;
+	case 28:
+		return 6;
+	case 32:
+		return 7;
+	}
+
+	return -EINVAL;
+}
+
+static const struct ac200_map ac200_bclk_div_map[] = {
+	{ .match = 1,	.value = 1 },
+	{ .match = 2,	.value = 2 },
+	{ .match = 4,	.value = 3 },
+	{ .match = 6,	.value = 4 },
+	{ .match = 8,	.value = 5 },
+	{ .match = 12,	.value = 6 },
+	{ .match = 16,	.value = 7 },
+	{ .match = 24,	.value = 8 },
+	{ .match = 32,	.value = 9 },
+	{ .match = 48,	.value = 10 },
+	{ .match = 64,	.value = 11 },
+	{ .match = 96,	.value = 12 },
+	{ .match = 128,	.value = 13 },
+	{ .match = 176,	.value = 14 },
+	{ .match = 192,	.value = 15 },
+};
+
+static int ac200_get_bclk_div(unsigned int sysclk_rate,
+			      unsigned int sample_rate, unsigned int period)
+{
+	unsigned int div = sysclk_rate / sample_rate / period;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(ac200_bclk_div_map); i++) {
+		const struct ac200_map *bdiv = &ac200_bclk_div_map[i];
+
+		if (bdiv->match == div)
+			return bdiv->value;
+	}
+
+	return -EINVAL;
+}
+
+static const struct ac200_map ac200_ssr_map[] = {
+	{ .match = 8000,	.value = 0 },
+	{ .match = 11025,	.value = 1 },
+	{ .match = 12000,	.value = 2 },
+	{ .match = 16000,	.value = 3 },
+	{ .match = 22050,	.value = 4 },
+	{ .match = 24000,	.value = 5 },
+	{ .match = 32000,	.value = 6 },
+	{ .match = 44100,	.value = 7 },
+	{ .match = 48000,	.value = 8 },
+	{ .match = 96000,	.value = 9 },
+	{ .match = 192000,	.value = 10 },
+};
+
+static int ac200_get_ssr(unsigned int sample_rate)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(ac200_ssr_map); i++) {
+		const struct ac200_map *ssr = &ac200_ssr_map[i];
+
+		if (ssr->match == sample_rate)
+			return ssr->value;
+	}
+
+	return -EINVAL;
+}
+
+static int ac200_codec_hw_params(struct snd_pcm_substream *substream,
+				 struct snd_pcm_hw_params *params,
+				 struct snd_soc_dai *dai)
+{
+	struct ac200_codec *priv = snd_soc_dai_get_drvdata(dai);
+	unsigned int slot_width = params_physical_width(params);
+	unsigned int sample_rate = params_rate(params);
+	unsigned int lrck_period, frame_width, sysclk;
+	int sr, sw, bclkdiv, ssr, ret;
+
+	sysclk = (sample_rate % 4000) ? AC200_SYSCLK_44K1 : AC200_SYSCLK_48K;
+	if (priv->sysclk && priv->sysclk != sysclk) {
+		dev_err(dai->dev,
+			"%u Hz needs a %u Hz MCLK, but MCLK is %u Hz\n",
+			sample_rate, sysclk, priv->sysclk);
+		return -EINVAL;
+	}
+
+	sr = ac200_get_sr_sw(params_width(params));
+	if (sr < 0) {
+		dev_err(dai->dev, "Unsupported sample width %u\n",
+			params_width(params));
+		return sr;
+	}
+
+	sw = ac200_get_sr_sw(slot_width);
+	if (sw < 0) {
+		dev_err(dai->dev, "Unsupported slot width %u\n", slot_width);
+		return sw;
+	}
+
+	switch (priv->format & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+	case SND_SOC_DAIFMT_RIGHT_J:
+	case SND_SOC_DAIFMT_LEFT_J:
+		lrck_period = slot_width;
+		frame_width = slot_width * 2;
+		break;
+	case SND_SOC_DAIFMT_DSP_A:
+	case SND_SOC_DAIFMT_DSP_B:
+		lrck_period = slot_width * 2;
+		frame_width = lrck_period;
+		break;
+	default:
+		dev_err(dai->dev, "Unsupported DAI format 0x%x\n",
+			priv->format & SND_SOC_DAIFMT_FORMAT_MASK);
+		return -EINVAL;
+	}
+
+	bclkdiv = ac200_get_bclk_div(sysclk, sample_rate, frame_width);
+	if (bclkdiv < 0) {
+		dev_err(dai->dev, "No BCLK divider for %u Hz, %u bit frames\n",
+			sample_rate, frame_width);
+		return bclkdiv;
+	}
+
+	ssr = ac200_get_ssr(sample_rate);
+	if (ssr < 0) {
+		dev_err(dai->dev, "Unsupported sample rate %u\n", sample_rate);
+		return ssr;
+	}
+
+	ret = regmap_update_bits(priv->regmap, AC200_I2S_FMT0,
+				 AC200_I2S_FMT0_SR_MASK |
+				 AC200_I2S_FMT0_SW_MASK,
+				 AC200_I2S_FMT0_SR(sr) |
+				 AC200_I2S_FMT0_SW(sw));
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->regmap, AC200_I2S_CLK,
+				 AC200_I2S_CLK_LRCK_MASK |
+				 AC200_I2S_CLK_BCLKDIV_MASK,
+				 AC200_I2S_CLK_LRCK(lrck_period) |
+				 AC200_I2S_CLK_BCLKDIV(bclkdiv));
+	if (ret)
+		return ret;
+
+	return regmap_update_bits(priv->regmap, AC200_SYS_SR_CTL,
+				  AC200_SYS_SR_CTL_SR_MASK,
+				  AC200_SYS_SR_CTL_SR(ssr));
+}
+
+static int ac200_codec_startup(struct snd_pcm_substream *substream,
+			       struct snd_soc_dai *dai)
+{
+	struct ac200_codec *priv = snd_soc_dai_get_drvdata(dai);
+	const struct snd_pcm_hw_constraint_list *list;
+
+	switch (priv->sysclk) {
+	case AC200_SYSCLK_48K:
+		list = &ac200_constraints_48k;
+		break;
+	case AC200_SYSCLK_44K1:
+		list = &ac200_constraints_44k1;
+		break;
+	default:
+		/* MCLK is unknown, hw_params() will have to sort it out. */
+		return 0;
+	}
+
+	return snd_pcm_hw_constraint_list(substream->runtime, 0,
+					  SNDRV_PCM_HW_PARAM_RATE, list);
+}
+
+static int ac200_codec_set_sysclk(struct snd_soc_dai *dai, int clk_id,
+				  unsigned int freq, int dir)
+{
+	struct ac200_codec *priv = snd_soc_dai_get_drvdata(dai);
+
+	if (freq != AC200_SYSCLK_48K && freq != AC200_SYSCLK_44K1) {
+		dev_err(dai->dev, "Unsupported MCLK rate %u\n", freq);
+		return -EINVAL;
+	}
+
+	priv->sysclk = freq;
+
+	return 0;
+}
+
+static int ac200_codec_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct ac200_codec *priv = snd_soc_dai_get_drvdata(dai);
+	unsigned int clk_value, inv_value, mode, offset;
+	int ret;
+
+	switch (fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) {
+	case SND_SOC_DAIFMT_CBP_CFP:
+		clk_value = AC200_I2S_CLK_BCLK_OUT | AC200_I2S_CLK_LRCK_OUT;
+		break;
+	case SND_SOC_DAIFMT_CBC_CFP:
+		clk_value = AC200_I2S_CLK_LRCK_OUT;
+		break;
+	case SND_SOC_DAIFMT_CBP_CFC:
+		clk_value = AC200_I2S_CLK_BCLK_OUT;
+		break;
+	case SND_SOC_DAIFMT_CBC_CFC:
+		clk_value = 0;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+		mode = AC200_I2S_FMT0_MODE_LEFT;
+		offset = 1;
+		break;
+	case SND_SOC_DAIFMT_RIGHT_J:
+		mode = AC200_I2S_FMT0_MODE_RIGHT;
+		offset = 0;
+		break;
+	case SND_SOC_DAIFMT_LEFT_J:
+		mode = AC200_I2S_FMT0_MODE_LEFT;
+		offset = 0;
+		break;
+	case SND_SOC_DAIFMT_DSP_A:
+		mode = AC200_I2S_FMT0_MODE_PCM;
+		offset = 1;
+		break;
+	case SND_SOC_DAIFMT_DSP_B:
+		mode = AC200_I2S_FMT0_MODE_PCM;
+		offset = 0;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF:
+		inv_value = 0;
+		break;
+	case SND_SOC_DAIFMT_NB_IF:
+		inv_value = AC200_I2S_FMT1_LRCK_POL_INVERT;
+		break;
+	case SND_SOC_DAIFMT_IB_NF:
+		inv_value = AC200_I2S_FMT1_BCLK_POL_INVERT;
+		break;
+	case SND_SOC_DAIFMT_IB_IF:
+		inv_value = AC200_I2S_FMT1_BCLK_POL_INVERT |
+			    AC200_I2S_FMT1_LRCK_POL_INVERT;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	ret = regmap_update_bits(priv->regmap, AC200_I2S_CLK,
+				 AC200_I2S_CLK_BCLK_OUT |
+				 AC200_I2S_CLK_LRCK_OUT, clk_value);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->regmap, AC200_I2S_FMT0,
+				 AC200_I2S_FMT0_MODE_MASK |
+				 AC200_I2S_FMT0_TX_OFFSET_MASK |
+				 AC200_I2S_FMT0_RX_OFFSET_MASK,
+				 AC200_I2S_FMT0_MODE(mode) |
+				 AC200_I2S_FMT0_TX_OFFSET(offset) |
+				 AC200_I2S_FMT0_RX_OFFSET(offset));
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->regmap, AC200_I2S_FMT1,
+				 AC200_I2S_FMT1_BCLK_POL_INVERT |
+				 AC200_I2S_FMT1_LRCK_POL_INVERT,
+				 inv_value);
+	if (!ret)
+		priv->format = fmt;
+
+	return ret;
+}
