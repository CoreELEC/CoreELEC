 drivers/gpu/drm/sun4i/sun8i_vi_layer.c | 112 ++++++++++++++-----------
 drivers/gpu/drm/sun4i/sun8i_vi_layer.h |  44 +++++-----
 6 files changed, 104 insertions(+), 85 deletions(-)

