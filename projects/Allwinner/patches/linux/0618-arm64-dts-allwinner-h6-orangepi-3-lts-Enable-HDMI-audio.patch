From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Thu, 24 Sep 2026 22:00:00 +0200
Subject: [PATCH] arm64: dts: allwinner: h6: orangepi-3-lts: Enable HDMI audio

Enable the HDMI audio card and its I2S controller, like on the other
H6 boards.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h6-orangepi-3-lts.dts b/arch/arm64/boot/dts/allwinner/sun50i-h6-orangepi-3-lts.dts
--- a/arch/arm64/boot/dts/allwinner/sun50i-h6-orangepi-3-lts.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h6-orangepi-3-lts.dts
@@ -165,6 +165,14 @@
 	};
 };
 
+&hdmi_sound {
+	status = "okay";
+};
+
+&i2s1 {
+	status = "okay";
+};
+
 &i2c3 {
 	status = "okay";
 };
