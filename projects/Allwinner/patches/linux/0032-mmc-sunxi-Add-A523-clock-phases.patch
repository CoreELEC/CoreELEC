From 0535e8f391f13b09c2c70981ccec8c1282684f98 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sat, 22 Aug 2026 07:11:01 +0200
Subject: [PATCH 32/33] mmc: sunxi: Add A523 clock phases

The A523 v5p3x controller uses register-selected drive and sample
phases. Program the SDK defaults when the card clock changes.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/mmc/host/sunxi-mmc.c | 106 ++++++++++++++++++++++++++++++-----
 1 file changed, 91 insertions(+), 15 deletions(-)

diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
index ff361b7eb139..f4890f064437 100644
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -9,6 +9,7 @@
  * (C) Copyright 2017 Sootech SA
  */
 
+#include <linux/bitfield.h>
 #include <linux/clk.h>
 #include <linux/clk/sunxi-ng.h>
 #include <linux/delay.h>
@@ -224,8 +225,17 @@
 #define SDXC_CLK_50M		2
 #define SDXC_CLK_50M_DDR	3
 #define SDXC_CLK_50M_DDR_8BIT	4
+#define SDXC_CLK_HIGH_SPEED	5
+#define SDXC_CLK_MODES		6
 
+/* SDXC_REG_SD_NTSR bits */
 #define SDXC_2X_TIMING_MODE	BIT(31)
+#define SDXC_STIMING_DAT_PH	GENMASK(9, 8)
+#define SDXC_STIMING_CMD_PH	GENMASK(5, 4)
+
+/* SDXC_REG_DRV_DL bits, 0 selects 90 and 1 selects 180 degrees */
+#define SDXC_DAT_DRV_PH_SEL	BIT(17)
+#define SDXC_CMD_DRV_PH_SEL	BIT(16)
 
 #define SDXC_CAL_START		BIT(15)
 #define SDXC_CAL_DONE		BIT(14)
@@ -241,6 +251,13 @@ struct sunxi_mmc_clk_delay {
 	u32 sample;
 };
 
+struct sunxi_mmc_timing {
+	u8 cmd_drv_phase;
+	u8 dat_drv_phase;
+	u8 cmd_sample_phase;
+	u8 dat_sample_phase;
+};
+
 struct sunxi_idma_des {
 	__le32 config;
 	__le32 buf_size;
@@ -253,6 +270,8 @@ struct sunxi_mmc_cfg {
 	u32 idma_des_shift;
 	const struct sunxi_mmc_clk_delay *clk_delays;
 
+	const struct sunxi_mmc_timing *timings;
+
 	/* does the IP block support autocalibration? */
 	bool can_calibrate;
 
@@ -755,6 +774,26 @@ static int sunxi_mmc_calibrate(struct sunxi_mmc_host *host, int reg_off)
 	return 0;
 }
 
+static int sunxi_mmc_clk_mode(struct mmc_ios *ios, u32 rate)
+{
+	if (rate <= 400000)
+		return SDXC_CLK_400K;
+
+	if (rate <= 25000000)
+		return SDXC_CLK_25M;
+
+	if (rate <= 52000000) {
+		if (ios->timing != MMC_TIMING_UHS_DDR50 &&
+		    ios->timing != MMC_TIMING_MMC_DDR52)
+			return SDXC_CLK_50M;
+		if (ios->bus_width == MMC_BUS_WIDTH_8)
+			return SDXC_CLK_50M_DDR_8BIT;
+		return SDXC_CLK_50M_DDR;
+	}
+
+	return SDXC_CLK_HIGH_SPEED;
+}
+
 static int sunxi_mmc_clk_set_phase(struct sunxi_mmc_host *host,
 				   struct mmc_ios *ios, u32 rate)
 {
@@ -768,21 +807,8 @@ static int sunxi_mmc_clk_set_phase(struct sunxi_mmc_host *host,
 	if (!host->cfg->clk_delays)
 		return 0;
 
-	/* determine delays */
-	if (rate <= 400000) {
-		index = SDXC_CLK_400K;
-	} else if (rate <= 25000000) {
-		index = SDXC_CLK_25M;
-	} else if (rate <= 52000000) {
-		if (ios->timing != MMC_TIMING_UHS_DDR50 &&
-		    ios->timing != MMC_TIMING_MMC_DDR52) {
-			index = SDXC_CLK_50M;
-		} else if (ios->bus_width == MMC_BUS_WIDTH_8) {
-			index = SDXC_CLK_50M_DDR_8BIT;
-		} else {
-			index = SDXC_CLK_50M_DDR;
-		}
-	} else {
+	index = sunxi_mmc_clk_mode(ios, rate);
+	if (index == SDXC_CLK_HIGH_SPEED) {
 		dev_dbg(mmc_dev(host->mmc), "Invalid clock... returning\n");
 		return -EINVAL;
 	}
@@ -796,6 +822,32 @@ static int sunxi_mmc_clk_set_phase(struct sunxi_mmc_host *host,
 			     host->cfg->clk_delays[index].output);
 }
 
+static void sunxi_mmc_set_timing_phase(struct sunxi_mmc_host *host,
+				       struct mmc_ios *ios, u32 rate)
+{
+	const struct sunxi_mmc_timing *timing;
+	u32 rval;
+
+	if (!host->cfg->timings || !host->use_new_timings)
+		return;
+
+	timing = &host->cfg->timings[sunxi_mmc_clk_mode(ios, rate)];
+
+	rval = mmc_readl(host, REG_DRV_DL);
+	rval &= ~(SDXC_CMD_DRV_PH_SEL | SDXC_DAT_DRV_PH_SEL);
+	if (timing->cmd_drv_phase)
+		rval |= SDXC_CMD_DRV_PH_SEL;
+	if (timing->dat_drv_phase)
+		rval |= SDXC_DAT_DRV_PH_SEL;
+	mmc_writel(host, REG_DRV_DL, rval);
+
+	rval = mmc_readl(host, REG_SD_NTSR);
+	rval &= ~(SDXC_STIMING_CMD_PH | SDXC_STIMING_DAT_PH);
+	rval |= FIELD_PREP(SDXC_STIMING_CMD_PH, timing->cmd_sample_phase);
+	rval |= FIELD_PREP(SDXC_STIMING_DAT_PH, timing->dat_sample_phase);
+	mmc_writel(host, REG_SD_NTSR, rval);
+}
+
 static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 				  struct mmc_ios *ios)
 {
@@ -883,6 +935,8 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 	if (ret)
 		return ret;
 
+	sunxi_mmc_set_timing_phase(host, ios, rate);
+
 	ret = sunxi_mmc_calibrate(host, SDXC_REG_SAMP_DL_REG);
 	if (ret)
 		return ret;
@@ -1242,6 +1296,27 @@ static const struct sunxi_mmc_cfg sun50i_h616_cfg = {
 	.needs_new_timings = true,
 };
 
+static const struct sunxi_mmc_timing sun55i_a523_timings[SDXC_CLK_MODES] = {
+	[SDXC_CLK_400K]		= { .cmd_drv_phase = 1 },
+	[SDXC_CLK_25M]		= { .cmd_drv_phase = 1 },
+	[SDXC_CLK_50M]		= { .cmd_drv_phase = 1, .dat_drv_phase = 1,
+				    .cmd_sample_phase = 1, .dat_sample_phase = 1 },
+	[SDXC_CLK_50M_DDR]	= { .cmd_drv_phase = 1, .dat_drv_phase = 1,
+				    .cmd_sample_phase = 1, .dat_sample_phase = 1 },
+	[SDXC_CLK_50M_DDR_8BIT]	= { .cmd_drv_phase = 1, .dat_drv_phase = 1,
+				    .cmd_sample_phase = 1, .dat_sample_phase = 1 },
+	[SDXC_CLK_HIGH_SPEED]	= { .cmd_drv_phase = 1 },
+};
+
+static const struct sunxi_mmc_cfg sun55i_a523_cfg = {
+	.idma_des_size_bits = 13,
+	.idma_des_shift = 2,
+	.can_calibrate = true,
+	.mask_data0 = true,
+	.needs_new_timings = true,
+	.timings = sun55i_a523_timings,
+};
+
 static const struct sunxi_mmc_cfg sun50i_a100_emmc_cfg = {
 	.idma_des_size_bits = 13,
 	.idma_des_shift = 2,
@@ -1262,6 +1337,7 @@ static const struct of_device_id sunxi_mmc_of_match[] = {
 	{ .compatible = "allwinner,sun50i-a100-mmc", .data = &sun20i_d1_cfg },
 	{ .compatible = "allwinner,sun50i-a100-emmc", .data = &sun50i_a100_emmc_cfg },
 	{ .compatible = "allwinner,sun50i-h616-mmc", .data = &sun50i_h616_cfg },
+	{ .compatible = "allwinner,sun55i-a523-mmc", .data = &sun55i_a523_cfg },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, sunxi_mmc_of_match);
-- 
2.43.0

