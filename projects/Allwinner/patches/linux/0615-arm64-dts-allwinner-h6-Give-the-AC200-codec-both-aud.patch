From 1ad13862ab98d84ca4bbca959f1771798b1bd554 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Tue, 28 Jul 2026 23:41:09 +0200
Subject: [PATCH] arm64: dts: allwinner: h6: Give the AC200 codec both audio
 clocks

The encoder needs 24.576MHz for the 48kHz sample rate family and
22.5792MHz for the 44.1kHz one, and the H6 audio PLL can produce both.
Describe both so that the card picks the one the rate needs, rather than
pinning the 48kHz family and having the 44.1kHz rates silently replaced
with their neighbours.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 arch/arm64/boot/dts/allwinner/sun50i-h6.dtsi | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h6.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-h6.dtsi
index d925f2f89bb5..b9e15675ea00 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h6.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h6.dtsi
@@ -37,18 +37,18 @@ ac200_sound: sound {
 		/*
 		 * The AC200 runs its audio block straight off MCLK, dividing
 		 * it internally, so MCLK is fixed rather than a multiple of
-		 * the sample rate. 24.576MHz covers the 48kHz family; the
-		 * 44.1kHz family would need 22.5792MHz instead.
+		 * the sample rate. One clock per sample rate family: 24.576MHz
+		 * for the 48kHz one and 22.5792MHz for the 44.1kHz one.
 		 */
 		simple-audio-card,cpu {
 			sound-dai = <&i2s3>;
-			system-clock-frequency = <24576000>;
+			system-clock-frequency = <24576000>, <22579200>;
 			system-clock-direction-out;
 		};
 
 		simple-audio-card,codec {
 			sound-dai = <&ac200_codec>;
-			system-clock-frequency = <24576000>;
+			system-clock-frequency = <24576000>, <22579200>;
 		};
 	};
 
