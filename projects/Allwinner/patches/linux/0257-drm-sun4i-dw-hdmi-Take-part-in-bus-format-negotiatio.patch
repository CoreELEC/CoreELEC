From 74a501e227bb38081219665eb27f42d53bff3fe4 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Mon, 20 Jul 2026 08:47:17 +0200
Subject: [PATCH 257/273] drm/sun4i: dw-hdmi: Take part in bus format
 negotiation

The dw-hdmi bridge skips bus format negotiation when it is the first
bridge in the chain and simply defaults to RGB888. In order to support
other display engine output formats, like YUV 4:2:0 for 4k@60
resolutions, the display engine constraints must be communicated to
dw-hdmi.

The sun8i bridge already sits in front of dw-hdmi. Let it take part in
bus format negotiation. For now it accepts only RGB888, which is exactly
what dw-hdmi assumed before, so there is no functional change.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c | 28 +++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
index 219b78e64e74..c3f0b8200e6d 100644
--- a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
+++ b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
@@ -18,6 +18,8 @@
 
 #include <media/cec-notifier.h>
 
+#include <uapi/linux/media-bus-format.h>
+
 #include "sun8i_dw_hdmi.h"
 #include "sun8i_tcon_top.h"
 
@@ -84,11 +86,37 @@ static int sun8i_hdmi_enc_atomic_check(struct drm_bridge *bridge,
 	return 0;
 }
 
+static u32 *
+sun8i_hdmi_enc_get_input_bus_fmts(struct drm_bridge *bridge,
+				  struct drm_bridge_state *bridge_state,
+				  struct drm_crtc_state *crtc_state,
+				  struct drm_connector_state *conn_state,
+				  u32 output_fmt,
+				  unsigned int *num_input_fmts)
+{
+	u32 *input_fmt;
+
+	*num_input_fmts = 0;
+
+	if (output_fmt != MEDIA_BUS_FMT_RGB888_1X24)
+		return NULL;
+
+	input_fmt = kmalloc_obj(*input_fmt);
+	if (!input_fmt)
+		return NULL;
+
+	*num_input_fmts = 1;
+	*input_fmt = output_fmt;
+
+	return input_fmt;
+}
+
 static const struct drm_bridge_funcs sun8i_hdmi_enc_bridge_funcs = {
 	.attach = sun8i_hdmi_enc_attach,
 	.detach = sun8i_hdmi_enc_detach,
 	.hpd_notify = sun8i_hdmi_enc_hpd_notify,
 	.atomic_check = sun8i_hdmi_enc_atomic_check,
+	.atomic_get_input_bus_fmts = sun8i_hdmi_enc_get_input_bus_fmts,
 	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
 	.atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
 	.atomic_reset = drm_atomic_helper_bridge_reset,
