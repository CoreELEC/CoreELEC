From 386d91bcfe535748a779c205fe1f84c4864bd229 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sun, 6 Sep 2026 11:24:27 +0200
Subject: [PATCH] arm64: dts: allwinner: h616: add audio hub

Add the audio hub node. Boards enable it through the sound card which
uses it.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
index 1598e86259ab..db19681ea9d6 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
@@ -805,6 +805,19 @@ codec: codec@5096000 {
 			status = "disabled";
 		};
 
+		ahub: audio-hub@5097000 {
+			#sound-dai-cells = <1>;
+			compatible = "allwinner,sun50i-h616-ahub";
+			reg = <0x05097000 0xb00>;
+			clocks = <&ccu CLK_BUS_AUDIO_HUB>, <&ccu CLK_AUDIO_HUB>;
+			clock-names = "bus", "mod";
+			resets = <&ccu RST_BUS_AUDIO_HUB>;
+			dmas = <&dma 3>, <&dma 3>, <&dma 4>, <&dma 4>,
+			       <&dma 5>, <&dma 5>;
+			dma-names = "tx0", "rx0", "tx1", "rx1", "tx2", "rx2";
+			status = "disabled";
+		};
+
 		usbotg: usb@5100000 {
 			compatible = "allwinner,sun50i-h616-musb",
 				     "allwinner,sun8i-h3-musb";
-- 
2.43.0

