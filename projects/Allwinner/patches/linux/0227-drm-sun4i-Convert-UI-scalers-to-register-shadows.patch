From 0de8a088478dbe27f2a29ac9b93219e3620b219a Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sun, 19 Jul 2026 16:12:14 +0200
Subject: [PATCH 227/273] drm/sun4i: Convert UI scalers to register shadows

UI plane scaling still writes its control and coefficient registers
directly. Add a shadow region for each UI scaler and use the VI scaler
shadow on DE33, where UI channels are backed by VSU8 blocks. Scaler
registers are now addressed relative to their shadow region, so drop
the base argument from the scaler macros.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/gpu/drm/sun4i/sun8i_ui_layer.c  |  9 ++++
 drivers/gpu/drm/sun4i/sun8i_ui_scaler.c | 59 ++++++++++++++++---------
 drivers/gpu/drm/sun4i/sun8i_ui_scaler.h | 18 ++++----
 3 files changed, 58 insertions(+), 28 deletions(-)

diff --git a/drivers/gpu/drm/sun4i/sun8i_ui_layer.c b/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
index a30dc41bdd8b..892647696c88 100644
--- a/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
@@ -271,6 +271,15 @@ struct sun8i_layer *sun8i_ui_layer_init_one(struct drm_device *drm,
 	if (!layer->layer_rdma)
 		return ERR_PTR(-ENOMEM);
 
+	if (layer->cfg->scaler_type[phy_index] != SUN8I_SCALER_NONE) {
+		if (layer->cfg->de_type == SUN8I_MIXER_DE33)
+			ret = sun8i_vi_scaler_init(layer, rdma, reg_base);
+		else
+			ret = sun8i_ui_scaler_init(layer, rdma, reg_base);
+		if (ret)
+			return ERR_PTR(ret);
+	}
+
 	/* possible crtcs are set later */
 	ret = drm_universal_plane_init(drm, &layer->plane, 0,
 				       &sun8i_ui_layer_funcs,
diff --git a/drivers/gpu/drm/sun4i/sun8i_ui_scaler.c b/drivers/gpu/drm/sun4i/sun8i_ui_scaler.c
index 34b1867e4aeb..d5faf1f3a364 100644
--- a/drivers/gpu/drm/sun4i/sun8i_ui_scaler.c
+++ b/drivers/gpu/drm/sun4i/sun8i_ui_scaler.c
@@ -10,8 +10,19 @@
  */
 
 #include "sun8i_ui_scaler.h"
+#include "sun8i_rdma.h"
 #include "sun8i_vi_scaler.h"
 
+static const struct reg_region sun8i_ui_scaler_regions[] = {
+	{ 0x000, 1 },
+	{ 0x040, 1 },
+	{ 0x080, 1 },
+	{ 0x088, 3 },
+	{ 0x098, 1 },
+	{ 0x200, SUN8I_UI_SCALER_COEFF_COUNT },
+	{ }
+};
+
 static const u32 lan2coefftab16[240] = {
 	0x00004000, 0x00033ffe, 0x00063efc, 0x000a3bfb,
 	0xff0f37fb, 0xfe1433fb, 0xfd192ffb, 0xfd1f29fb,
@@ -103,6 +114,17 @@ static u32 sun8i_ui_scaler_base(struct sun8i_layer *layer)
 		       DE2_UI_SCALER_UNIT_SIZE * (layer->channel - offset);
 }
 
+int sun8i_ui_scaler_init(struct sun8i_layer *layer, struct sun8i_rdma *rdma,
+			 void __iomem *reg_base)
+{
+	u32 base = sun8i_ui_scaler_base(layer);
+
+	layer->scaler_rdma = sun8i_rdma_add_unit(rdma, reg_base + base, 0x240,
+						 sun8i_ui_scaler_regions);
+
+	return layer->scaler_rdma ? 0 : -ENOMEM;
+}
+
 static int sun8i_ui_scaler_coef_offset(unsigned int step)
 {
 	unsigned int scale, int_part, float_part;
@@ -129,9 +151,7 @@ static int sun8i_ui_scaler_coef_offset(unsigned int step)
 
 void sun8i_ui_scaler_enable(struct sun8i_layer *layer, bool enable)
 {
-	u32 val, base;
-
-	base = sun8i_ui_scaler_base(layer);
+	u32 val;
 
 	if (enable)
 		val = SUN8I_SCALER_GSU_CTRL_EN |
@@ -139,7 +159,8 @@ void sun8i_ui_scaler_enable(struct sun8i_layer *layer, bool enable)
 	else
 		val = 0;
 
-	regmap_write(layer->regs, SUN8I_SCALER_GSU_CTRL(base), val);
+	sun8i_rdma_write(layer->scaler_rdma,
+			 SUN8I_SCALER_GSU_CTRL, val);
 }
 
 void sun8i_ui_scaler_setup(struct sun8i_layer *layer,
@@ -148,9 +169,6 @@ void sun8i_ui_scaler_setup(struct sun8i_layer *layer,
 {
 	u32 insize, outsize;
 	int offset;
-	u32 base;
-
-	base = sun8i_ui_scaler_base(layer);
 
 	hphase <<= SUN8I_UI_SCALER_PHASE_FRAC - 16;
 	vphase <<= SUN8I_UI_SCALER_PHASE_FRAC - 16;
@@ -160,19 +178,20 @@ void sun8i_ui_scaler_setup(struct sun8i_layer *layer,
 	insize = SUN8I_UI_SCALER_SIZE(src_w, src_h);
 	outsize = SUN8I_UI_SCALER_SIZE(dst_w, dst_h);
 
-	regmap_write(layer->regs,
-		     SUN8I_SCALER_GSU_OUTSIZE(base), outsize);
-	regmap_write(layer->regs,
-		     SUN8I_SCALER_GSU_INSIZE(base), insize);
-	regmap_write(layer->regs,
-		     SUN8I_SCALER_GSU_HSTEP(base), hscale);
-	regmap_write(layer->regs,
-		     SUN8I_SCALER_GSU_VSTEP(base), vscale);
-	regmap_write(layer->regs,
-		     SUN8I_SCALER_GSU_HPHASE(base), hphase);
-	regmap_write(layer->regs,
-		     SUN8I_SCALER_GSU_VPHASE(base), vphase);
+	sun8i_rdma_write(layer->scaler_rdma, SUN8I_SCALER_GSU_OUTSIZE,
+			 outsize);
+	sun8i_rdma_write(layer->scaler_rdma, SUN8I_SCALER_GSU_INSIZE,
+			 insize);
+	sun8i_rdma_write(layer->scaler_rdma, SUN8I_SCALER_GSU_HSTEP,
+			 hscale);
+	sun8i_rdma_write(layer->scaler_rdma, SUN8I_SCALER_GSU_VSTEP,
+			 vscale);
+	sun8i_rdma_write(layer->scaler_rdma, SUN8I_SCALER_GSU_HPHASE,
+			 hphase);
+	sun8i_rdma_write(layer->scaler_rdma, SUN8I_SCALER_GSU_VPHASE,
+			 vphase);
 	offset = sun8i_ui_scaler_coef_offset(hscale);
-	regmap_bulk_write(layer->regs, SUN8I_SCALER_GSU_HCOEFF(base, 0),
+	sun8i_rdma_memcpy(layer->scaler_rdma,
+			  SUN8I_SCALER_GSU_HCOEFF(0),
 			  &lan2coefftab16[offset], SUN8I_UI_SCALER_COEFF_COUNT);
 }
diff --git a/drivers/gpu/drm/sun4i/sun8i_ui_scaler.h b/drivers/gpu/drm/sun4i/sun8i_ui_scaler.h
index 872d88a58e7e..46da0ed4df94 100644
--- a/drivers/gpu/drm/sun4i/sun8i_ui_scaler.h
+++ b/drivers/gpu/drm/sun4i/sun8i_ui_scaler.h
@@ -23,19 +23,21 @@
 #define SUN8I_UI_SCALER_COEFF_COUNT		16
 #define SUN8I_UI_SCALER_SIZE(w, h)		(((h) - 1) << 16 | ((w) - 1))
 
-#define SUN8I_SCALER_GSU_CTRL(base)		((base) + 0x0)
-#define SUN8I_SCALER_GSU_OUTSIZE(base)		((base) + 0x40)
-#define SUN8I_SCALER_GSU_INSIZE(base)		((base) + 0x80)
-#define SUN8I_SCALER_GSU_HSTEP(base)		((base) + 0x88)
-#define SUN8I_SCALER_GSU_VSTEP(base)		((base) + 0x8c)
-#define SUN8I_SCALER_GSU_HPHASE(base)		((base) + 0x90)
-#define SUN8I_SCALER_GSU_VPHASE(base)		((base) + 0x98)
-#define SUN8I_SCALER_GSU_HCOEFF(base, index)	((base) + 0x200 + 0x4 * (index))
+#define SUN8I_SCALER_GSU_CTRL			0x0
+#define SUN8I_SCALER_GSU_OUTSIZE		0x40
+#define SUN8I_SCALER_GSU_INSIZE			0x80
+#define SUN8I_SCALER_GSU_HSTEP			0x88
+#define SUN8I_SCALER_GSU_VSTEP			0x8c
+#define SUN8I_SCALER_GSU_HPHASE			0x90
+#define SUN8I_SCALER_GSU_VPHASE			0x98
+#define SUN8I_SCALER_GSU_HCOEFF(index)		(0x200 + 0x4 * (index))
 
 #define SUN8I_SCALER_GSU_CTRL_EN		BIT(0)
 #define SUN8I_SCALER_GSU_CTRL_COEFF_RDY		BIT(4)
 
 void sun8i_ui_scaler_enable(struct sun8i_layer *layer, bool enable);
+int sun8i_ui_scaler_init(struct sun8i_layer *layer, struct sun8i_rdma *rdma,
+			 void __iomem *reg_base);
 void sun8i_ui_scaler_setup(struct sun8i_layer *layer,
 			   u32 src_w, u32 src_h, u32 dst_w, u32 dst_h,
 			   u32 hscale, u32 vscale, u32 hphase, u32 vphase);
-- 
2.43.0

