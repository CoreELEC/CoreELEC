From a7eb855b2e02f36f0165bc95a57753f60f8e7027 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sat, 18 Jul 2026 13:31:18 +0200
Subject: [PATCH 226/273] drm/sun4i: Convert VI processing blocks to register
 shadows

VI plane updates also program their scaler and channel CSC blocks. Leaving
those writes on regmap would make a plane update partially bypass RCQ
and could expose mixed old and new state.

Give each enabled VI scaler and CSC its own shadow region and route
coefficient and control writes through it. The conversion covers DE2,
DE3 and DE33 register layouts.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/gpu/drm/sun4i/sun8i_csc.c       | 107 +++++++++++------
 drivers/gpu/drm/sun4i/sun8i_csc.h       |   3 +
 drivers/gpu/drm/sun4i/sun8i_mixer.h     |   2 +
 drivers/gpu/drm/sun4i/sun8i_vi_layer.c  |  10 ++
 drivers/gpu/drm/sun4i/sun8i_vi_scaler.c | 153 ++++++++++++++----------
 drivers/gpu/drm/sun4i/sun8i_vi_scaler.h |  50 ++++----
 6 files changed, 202 insertions(+), 123 deletions(-)

diff --git a/drivers/gpu/drm/sun4i/sun8i_csc.c b/drivers/gpu/drm/sun4i/sun8i_csc.c
index 316b6479b677..d540eb8db120 100644
--- a/drivers/gpu/drm/sun4i/sun8i_csc.c
+++ b/drivers/gpu/drm/sun4i/sun8i_csc.c
@@ -10,6 +10,24 @@
 
 #include "sun8i_csc.h"
 #include "sun8i_mixer.h"
+#include "sun8i_rdma.h"
+
+static const struct reg_region sun8i_csc_regions[] = {
+	{ 0x00, 1 },
+	{ 0x10, 12 },
+	{ }
+};
+
+static const struct reg_region sun8i_de3_csc_regions[] = {
+	{ 0x00, 12 },
+	{ }
+};
+
+static const struct reg_region sun8i_de33_csc_regions[] = {
+	{ 0x00, 1 },
+	{ 0x04, 15 },
+	{ }
+};
 
 enum sun8i_csc_mode {
 	SUN8I_CSC_MODE_OFF,
@@ -23,6 +41,32 @@ static const u32 ccsc_base[][2] = {
 	[CCSC_D1_MIXER0_LAYOUT]	= {CCSC00_OFFSET, CCSC01_D1_OFFSET},
 };
 
+int sun8i_csc_init(struct sun8i_layer *layer, struct sun8i_rdma *rdma,
+		   void __iomem *reg_base)
+{
+	const struct reg_region *regions;
+	u32 base, size;
+
+	if (layer->cfg->de_type == SUN8I_MIXER_DE3) {
+		base = DE3_BLD_BASE + 0x110 + layer->channel * 0x30;
+		regions = sun8i_de3_csc_regions;
+		size = 0x30;
+	} else if (layer->cfg->de_type == SUN8I_MIXER_DE33) {
+		base = DE33_CCSC_BASE + layer->channel * DE33_CH_SIZE;
+		regions = sun8i_de33_csc_regions;
+		size = 0x44;
+	} else {
+		base = ccsc_base[layer->cfg->ccsc][layer->channel];
+		regions = sun8i_csc_regions;
+		size = 0x40;
+	}
+
+	layer->csc_rdma = sun8i_rdma_add_unit(rdma, reg_base + base, size,
+					      regions);
+
+	return layer->csc_rdma ? 0 : -ENOMEM;
+}
+
 /*
  * Factors are in two's complement format, 10 bits for fractinal part.
  * First tree values in each line are multiplication factor and last
@@ -137,7 +181,7 @@ void sun8i_de3_ccsc_init(struct regmap *map)
 		sun8i_de3_ccsc_set_identity(map, i);
 }
 
