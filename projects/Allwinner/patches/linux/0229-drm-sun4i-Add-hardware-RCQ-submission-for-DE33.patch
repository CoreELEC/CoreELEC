-		   void __iomem *reg_base)
+		   void __iomem *reg_base, u32 reg_offset_base)
 {
 	const struct reg_region *regions;
 	u32 base, size;
@@ -61,8 +61,8 @@ int sun8i_csc_init(struct sun8i_layer *layer, struct sun8i_rdma *rdma,
 		size = 0x40;
