+
 enum {
 	/* First mixer or second mixer with VEP support. */
 	CCSC_MIXER0_LAYOUT,
@@ -172,7 +174,7 @@ enum sun8i_mixer_type {
  *	scaler and 2 UI channels with scaler, bitmask would be 0xC.
