+++ b/drivers/gpu/drm/sun4i/sun50i_planes.c
@@ -34,7 +34,7 @@ static const struct sun50i_planes_quirks sun50i_h616_planes_quirks = {
 		 * improvements to properly support it.
 		 */
 		.scaler_mask    = 0,
-		.scanline_yuv	= 4096,
+		.scanline_yuv	= {4096, 2048, 2048},
 	},
 };
 
