### Seekwave SWT6621S
### this driver is split in three individual kernel modules (Wi-Fi platform, Wi-Fi, Bluetooth)
ENV{MODALIAS}=="?*", ENV{SUBSYSTEM}=="sdio", ENV{SDIO_ID}=="1FFE:6621", GOTO="load_module"
GOTO="end"

LABEL="load_module"
ENV{MODALIAS}=="?*", ENV{SUBSYSTEM}=="sdio", RUN{builtin}+="kmod load skw_sdio_lite", RUN{builtin}+="kmod load swt6621s_wifi", RUN{builtin}+="kmod load skwbt"

LABEL="end"
