From dca1ff725a10a02179cd2bbbe9d4293d1bd68cf2 Mon Sep 17 00:00:00 2001
From: Peter <peter.vicman@gmail.com>
Date: Mon, 2 Nov 2026 16:20:46 +0100
Subject: [PATCH] aic8800: do not take the power control lock on SDIO power on

Taken from the CoreELEC forum fix for Amlogic boards. Also declare
aicwf_prealloc_init() and aicwf_prealloc_exit() with a (void)
parameter list.
---
 src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aicsdio.c       | 2 +-
 .../driver_fw/driver/aic8800/aic8800_fdrv/aicwf_rx_prealloc.c | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aicsdio.c b/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aicsdio.c
index 83f45cb..ddc8f7c 100644
--- a/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aicsdio.c
+++ b/src/SDIO/driver_fw/driver/aic8800/aic8800_bsp/aicsdio.c
@@ -560,7 +560,7 @@ static int aicbsp_platform_power_on(void)
 		extern_wifi_set_enable(1);
 		mdelay(200);
 		sdio_reinit();
-		set_power_control_lock(1);
+		//set_power_control_lock(1);
 #endif
 
 #ifdef CONFIG_PLATFORM_ROCKCHIP2
diff --git a/src/SDIO/driver_fw/driver/aic8800/aic8800_fdrv/aicwf_rx_prealloc.c b/src/SDIO/driver_fw/driver/aic8800/aic8800_fdrv/aicwf_rx_prealloc.c
index 59502b8..e9641c5 100644
--- a/src/SDIO/driver_fw/driver/aic8800/aic8800_fdrv/aicwf_rx_prealloc.c
+++ b/src/SDIO/driver_fw/driver/aic8800/aic8800_fdrv/aicwf_rx_prealloc.c
@@ -49,7 +49,7 @@ void aicwf_prealloc_rxbuff_free(struct rx_buff *rxbuff, spinlock_t *lock)
     spin_unlock_irqrestore(lock, flags);
 }
 
-int aicwf_prealloc_init()
+int aicwf_prealloc_init(void)
 {
     struct rx_buff *rxbuff;
     int i = 0;
@@ -79,7 +79,7 @@ int aicwf_prealloc_init()
     return 0;
 }
 
-void aicwf_prealloc_exit()
+void aicwf_prealloc_exit(void)
 {
     struct rx_buff *rxbuff;
     struct rx_buff *pos;
