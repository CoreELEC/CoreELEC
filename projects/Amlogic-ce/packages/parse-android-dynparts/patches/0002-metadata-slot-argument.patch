 constexpr std::string_view kDmPrefix = "dynpart-";
 
+// Accepts a metadata slot number, or a slot suffix "a"/"_a", "b"/"_b".
+// Range is checked by ReadMetadata against the geometry's slot count.
+static bool ParseSlot(const std::string_view arg, uint32_t* slot) {
+  std::string_view s = arg;
+  if (!s.empty() && s.front() == '_') s.remove_prefix(1);
+  if (s.size() == 1 && s[0] >= 'a' && s[0] <= 'z') {
+    *slot = s[0] - 'a';
+    return true;
+  }
+  if (s.empty() || s.size() > 2) return false;
+  uint32_t n = 0;
+  for (char c : s) {
+    if (c < '0' || c > '9') return false;
+    n = n * 10 + (c - '0');
+  }
+  *slot = n;
+  return true;
+}
