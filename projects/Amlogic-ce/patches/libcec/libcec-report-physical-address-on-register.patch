From 5d4460548b147738b71f87f749f34e6b7ba9666d Mon Sep 17 00:00:00 2001
From: Portisch <hugo.portisch@yahoo.de>
Date: Sat, 7 Nov 2026 10:29:29 +0100
Subject: [PATCH] fixed: announce the physical address when it is already known

A client whose physical address is known when it registers, like with
the AOCEC adapter, never reports it after its logical address is
allocated. The TV only finds the device on its next bus scan, which
can take more than 10 seconds, and does not route remote keys to it.
---
 src/libcec/CECClient.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/libcec/CECClient.cpp b/src/libcec/CECClient.cpp
index 989528d9..d6957793 100644
--- a/src/libcec/CECClient.cpp
+++ b/src/libcec/CECClient.cpp
@@ -141,10 +141,16 @@ bool CCECClient::OnRegister(void)
     (*it)->SetMenuLanguage(std::string(m_configuration.strDeviceLanguage, 3));
   }
 
-  // set the physical address, unless already resolved (e.g. via SetHDMIPort during RegisterClient)
+  // set the physical address, or announce it when it was already resolved (e.g. via SetHDMIPort
+  // during RegisterClient)
   if (!CLibCEC::IsValidPhysicalAddress(m_configuration.iPhysicalAddress) ||
       m_configuration.iPhysicalAddress == CEC_PHYSICAL_ADDRESS_TV)
     SetPhysicalAddress(m_configuration);
+  else
+  {
+    for (CECDEVICEVEC::iterator it = devices.begin(); it != devices.end(); it++)
+      (*it)->TransmitPhysicalAddress(false);
+  }
 
   // make the primary device the active source if the option is set
   if (m_configuration.bActivateSource == 1)
-- 
