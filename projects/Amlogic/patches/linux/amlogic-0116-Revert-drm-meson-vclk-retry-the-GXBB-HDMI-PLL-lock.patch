From ff5b60ef1d5b6c21d20391639dfd942a5424e1da Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Sun, 27 Sep 2026 07:54:57 +0000
Subject: [PATCH 116/172] Revert "drm/meson: vclk: retry the GXBB HDMI PLL
 lock"

This reverts commit 0265466903b7ea19bdd9f3261c880fca671da689.
---
 drivers/gpu/drm/meson/meson_vclk.c | 16 ++--------------
 1 file changed, 2 insertions(+), 14 deletions(-)

diff --git a/drivers/gpu/drm/meson/meson_vclk.c b/drivers/gpu/drm/meson/meson_vclk.c
index 092a2c2275b8..50f7ee83f950 100644
--- a/drivers/gpu/drm/meson/meson_vclk.c
+++ b/drivers/gpu/drm/meson/meson_vclk.c
@@ -625,20 +625,8 @@ static void meson_hdmi_pll_set_params(struct meson_drm *priv, unsigned int m,
 				   0x7 << 28, HHI_HDMI_PLL_CNTL_EN);
 
 		/* Poll for lock bit */
-		while (regmap_read_poll_timeout(priv->hhi, HHI_HDMI_PLL_CNTL,
-						val, (val & HDMI_PLL_LOCK),
-						10, 100)) {
-			if (!--lock_tries) {
-				pr_err("HDMI PLL failed to lock for m=0x%x frac=0x%x\n",
-				       m, frac);
-				break;
-			}
-
-			regmap_update_bits(priv->hhi, HHI_HDMI_PLL_CNTL,
-					   HDMI_PLL_RESET, HDMI_PLL_RESET);
-			regmap_update_bits(priv->hhi, HHI_HDMI_PLL_CNTL,
-					   HDMI_PLL_RESET, 0);
-		}
+		regmap_read_poll_timeout(priv->hhi, HHI_HDMI_PLL_CNTL,
+					 val, (val & HDMI_PLL_LOCK), 10, 0);
 	} else if (meson_vpu_is_compatible(priv, VPU_COMPATIBLE_GXM) ||
 		   meson_vpu_is_compatible(priv, VPU_COMPATIBLE_GXL)) {
 		regmap_write(priv->hhi, HHI_HDMI_PLL_CNTL, 0x40000200 | m);
-- 
