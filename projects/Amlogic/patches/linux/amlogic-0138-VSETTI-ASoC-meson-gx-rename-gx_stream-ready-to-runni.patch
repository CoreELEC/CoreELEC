From 99e04b05d096938e5b7d0a2e11d053a9fa0c0cc8 Mon Sep 17 00:00:00 2001
From: Valerio Setti <vsetti@baylibre.com>
Date: Thu, 1 Oct 2026 00:30:31 +0200
Subject: [PATCH 138/172] VSETTI: ASoC: meson: gx: rename gx_stream ready to
 running

The flag now only tracks whether the formatters are enabled, so name it
accordingly. No functional change.

Signed-off-by: Valerio Setti <vsetti@baylibre.com>
---
 sound/soc/meson/gx-formatter.c | 6 +++---
 sound/soc/meson/gx-interface.h | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/sound/soc/meson/gx-formatter.c b/sound/soc/meson/gx-formatter.c
index bbf5584d1175..7f01899c9977 100644
--- a/sound/soc/meson/gx-formatter.c
+++ b/sound/soc/meson/gx-formatter.c
@@ -70,7 +70,7 @@ static int gx_formatter_attach(struct gx_formatter *formatter)
 	}
 
 	/* Catch up if the stream is already running when we attach */
-	if (ts->ready)
+	if (ts->running)
 		gx_formatter_enable(formatter);
 
 	list_add_tail(&formatter->list, &ts->formatter_list);
@@ -244,7 +244,7 @@ int gx_stream_start(struct gx_stream *ts)
 	list_for_each_entry(formatter, &ts->formatter_list, list)
 		gx_formatter_enable(formatter);
 
-	ts->ready = true;
+	ts->running = true;
 
 	mutex_unlock(&ts->lock);
 	return 0;
@@ -256,7 +256,7 @@ void gx_stream_stop(struct gx_stream *ts)
 	struct gx_formatter *formatter;
 
 	mutex_lock(&ts->lock);
-	ts->ready = false;
+	ts->running = false;
 
 	/* Stop all the formatters attached to the stream */
 	list_for_each_entry(formatter, &ts->formatter_list, list) {
diff --git a/sound/soc/meson/gx-interface.h b/sound/soc/meson/gx-interface.h
index cefbb38769d9..52d44d8f438e 100644
--- a/sound/soc/meson/gx-interface.h
+++ b/sound/soc/meson/gx-interface.h
@@ -29,7 +29,7 @@ struct gx_stream {
 	unsigned int width;
 	unsigned int physical_width;
 	bool prepared;
-	bool ready;
+	bool running;
 
 	/* For continuous clock tracking */
 	bool clk_enabled;
-- 
