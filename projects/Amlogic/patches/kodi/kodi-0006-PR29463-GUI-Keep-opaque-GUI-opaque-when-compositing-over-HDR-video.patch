From 6c74325b163d345fd3e64c96a07168fc0ae74cfd Mon Sep 17 00:00:00 2001
From: cinemaONE <35371193+cinema-ONE@users.noreply.github.com>
Date: Sun, 27 Sep 2026 18:34:33 +0200
Subject: [PATCH 1/2] [GUI] Let the video show through a videowindow during HDR
 compositing

During HDR passthrough on GBM the GUI is drawn into an FBO and the video
is drawn behind it, as with a video plane. A window's background clear
fills that FBO with opaque alpha, and a videowindow only cleared its rect
for a video layer. So the video stayed covered: a small videowindow in a
window with an opaque background showed none of it, and in Estuary's
Home only the squared alpha blend let some of it through. Clear the rect
in the HDR case too.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 xbmc/guilib/GUIVideoControl.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/xbmc/guilib/GUIVideoControl.cpp b/xbmc/guilib/GUIVideoControl.cpp
index 88bc119584..2e92b599d5 100644
--- a/xbmc/guilib/GUIVideoControl.cpp
+++ b/xbmc/guilib/GUIVideoControl.cpp
@@ -66,7 +66,8 @@ void CGUIVideoControl::Render()
 
     KODI::UTILS::COLOR::Color alpha =
         CServiceBroker::GetWinSystem()->GetGfxContext().MergeAlpha(0xFF000000) >> 24;
-    if (appPlayer->IsRenderingVideoLayer())
+    // The HDR composite also draws the video behind the GUI, so it needs the same hole.
+    if (appPlayer->IsRenderingVideoLayer() || CServiceBroker::GetWinSystem()->IsHdrComposite())
     {
       CRect old = CServiceBroker::GetWinSystem()->GetGfxContext().GetScissors();
       CRect region = GetRenderRegion();
@@ -82,7 +83,7 @@ void CGUIVideoControl::Render()
         CServiceBroker::GetWinSystem()->GetGfxContext().Clear(0);
       CServiceBroker::GetWinSystem()->GetGfxContext().SetScissors(old);
     }
-    else
+    if (!appPlayer->IsRenderingVideoLayer())
       appPlayer->Render(false, alpha);
 
     CServiceBroker::GetWinSystem()->GetGfxContext().RemoveTransform();
-- 
