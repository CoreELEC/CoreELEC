From 3d40e16a322f8007bc40ed3888ce4cdecaf91b7f Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Fri, 18 Sep 2026 08:29:46 +0000
Subject: [PATCH] conf: cards: add a configuration for the Amlogic AXG sound
 card

The AXG audio interface is what the G12 and SM1 SoCs carry, driven by the
axg-sound-card driver, and it needs the same description the AIU does: the
HDMI transmitter takes linear PCM from the I2S interface and anything that
is not linear PCM from a S/PDIF encoder, which a player cannot know.

Describe the card the same way.  The hdmi device sends a stream to the
S/PDIF leg when the player asks for channel status with the non-audio bit
set and to the I2S interface otherwise, and the leg is shared with the
iec958 device that describes an optical output.

These SoCs have two S/PDIF encoders and a board may fit either or both,
keeping one for HDMI and the other for its optical jack, so the channel
status is set on whichever are present and only the one a stream is routed
to is used.  It is set on the HDMI codec as well, which needs it to tell a
compressed stream from linear PCM, and for a high bit rate stream to be
carried in HBR packets rather than as eight channels of audio.

Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 src/conf/cards/Makefile.am         |   1 +
 src/conf/cards/axg-sound-card.conf | 235 +++++++++++++++++++++++++++++
 2 files changed, 236 insertions(+)
 create mode 100644 src/conf/cards/axg-sound-card.conf

diff --git a/src/conf/cards/Makefile.am b/src/conf/cards/Makefile.am
index 48fddfe7..dc2881d7 100644
--- a/src/conf/cards/Makefile.am
+++ b/src/conf/cards/Makefile.am
@@ -12,6 +12,7 @@ cfg_files = aliases.conf \
 	Audigy2.conf \
 	Aureon51.conf \
 	Aureon71.conf \
+	axg-sound-card.conf \
 	CA0106.conf \
 	CMI8338.conf \
 	CMI8338-SWIEC.conf \
diff --git a/src/conf/cards/axg-sound-card.conf b/src/conf/cards/axg-sound-card.conf
new file mode 100644
index 00000000..e66ae0c2
--- /dev/null
+++ b/src/conf/cards/axg-sound-card.conf
@@ -0,0 +1,235 @@
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2020-present Team LibreELEC (https://libreelec.tv)
+
+#
+# Configuration for Amlogic AXG audio
+#
+
+axg-sound-card.pcm.default {
+	@args [ CARD ]
+	@args.CARD { type string }
+	type softvol
+	slave.pcm {
+		type plug
+		slave {
+			pcm {
+				type hw
+				card $CARD
+				device 0
+			}
+		}
+	}
+	control {
+		name "PCM Playback Volume"
+		card $CARD
+	}
+}
+
+#
+# The S/PDIF encoder.  It drives an optical output where a board has one, and
+# it is also the interface the HDMI transmitter takes anything that is not
+# linear PCM from, so this is the leg a compressed stream leaves by whichever
+# output it is bound for.
+#
+# Which encoder a board fits differs, and a board may have either or both, so
+# set the channel status on whichever is present.  Only the one the mixer
+# routes a stream to is used.
+#
+axg-sound-card.pcm.spdif_leg {
+	@args [ CARD AES0 AES1 AES2 AES3 ]
+	@args.CARD { type string }
+	@args.AES0 { type integer }
+	@args.AES1 { type integer }
+	@args.AES2 { type integer }
+	@args.AES3 { type integer }
+	type hooks
+	slave.pcm {
+		type hw
+		card $CARD
+		device 1
+	}
+	hooks.0 {
+		type ctl_elems
+		hook_args [
+			{
+				name "SPDIFOUT_A IEC958 Playback Default"
+				interface PCM
+				lock true
+				preserve true
+				optional true
+				value [ $AES0 $AES1 $AES2 $AES3 ]
+			}
+			{
+				name "SPDIFOUT_B IEC958 Playback Default"
+				interface PCM
+				lock true
+				preserve true
+				optional true
+				value [ $AES0 $AES1 $AES2 $AES3 ]
+			}
+		]
+	}
+}
+
+<confdir:pcm/hdmi.conf>
+
+#
+# HDMI takes linear PCM from the I2S interface and everything else from the
+# S/PDIF interface, so a compressed stream has to leave through the S/PDIF
+# encoder even though it is bound for HDMI.  Send it there when the player
+# asks for channel status with the non-audio bit set, so that one HDMI device
+# serves both.
+#
+axg-sound-card.pcm.hdmi.0 {
+	@args [ CARD AES0 AES1 AES2 AES3 ]
+	@args.CARD { type string }
+	@args.AES0 { type integer }
+	@args.AES1 { type integer }
+	@args.AES2 { type integer }
+	@args.AES3 { type integer }
+	type empty
+	slave.pcm {
+		@func refer
+		name {
+			@func concat
+			strings [
+				"cards.axg-sound-card.pcm.hdmi_nonaudio." $AES0
+				":CARD=" $CARD
+				",AES0=" $AES0 ",AES1=" $AES1
+				",AES2=" $AES2 ",AES3=" $AES3
+			]
+		}
+		# Linear PCM, up to eight channels, over the I2S interface.
+		default {
+			type hooks
+			slave.pcm {
+				type hw
+				card $CARD
+				device 0
+			}
+			hooks.0 {
+				type ctl_elems
+				hook_args [
+					{
+						name "IEC958 Playback Default"
+						interface PCM
+						lock true
+						preserve true
+						optional true
+						value [ $AES0 $AES1 $AES2 $AES3 ]
+					}
+				]
+			}
+		}
+	}
+}
+
+#
+# Consumer channel status carrying the non-audio bit.  A player sets the
+# copyright bit with it or leaves it clear, so name both; anything else falls
+# back to the I2S interface above.
+#
+axg-sound-card.pcm.hdmi_nonaudio.2 {
+	@args [ CARD AES0 AES1 AES2 AES3 ]
+	@args.CARD { type string }
+	@args.AES0 { type integer }
+	@args.AES1 { type integer }
+	@args.AES2 { type integer }
+	@args.AES3 { type integer }
+	type hooks
+	slave.pcm {
+		@func refer
+		name {
+			@func concat
+			strings [
+				"cards.axg-sound-card.pcm.spdif_leg"
+				":CARD=" $CARD
+				",AES0=" $AES0 ",AES1=" $AES1
+				",AES2=" $AES2 ",AES3=" $AES3
+			]
+		}
+	}
+	hooks.0 {
+		type ctl_elems
+		hook_args [
+			#
+			# The HDMI codec keeps its own channel status and hands it
+			# to the transmitter, which needs it to tell an HBR stream
+			# from any other, so set it here as well as on the encoder.
+			#
+			{
+				name "IEC958 Playback Default"
+				interface PCM
+				lock true
+				preserve true
+				optional true
+				value [ $AES0 $AES1 $AES2 $AES3 ]
+			}
+		]
+	}
+}
+
+axg-sound-card.pcm.hdmi_nonaudio.6 {
+	@args [ CARD AES0 AES1 AES2 AES3 ]
+	@args.CARD { type string }
+	@args.AES0 { type integer }
+	@args.AES1 { type integer }
+	@args.AES2 { type integer }
+	@args.AES3 { type integer }
+	type hooks
+	slave.pcm {
+		@func refer
+		name {
+			@func concat
+			strings [
+				"cards.axg-sound-card.pcm.spdif_leg"
+				":CARD=" $CARD
+				",AES0=" $AES0 ",AES1=" $AES1
+				",AES2=" $AES2 ",AES3=" $AES3
+			]
+		}
+	}
+	hooks.0 {
+		type ctl_elems
+		hook_args [
+			#
+			# The HDMI codec keeps its own channel status and hands it
+			# to the transmitter, which needs it to tell an HBR stream
+			# from any other, so set it here as well as on the encoder.
+			#
+			{
+				name "IEC958 Playback Default"
+				interface PCM
+				lock true
+				preserve true
+				optional true
+				value [ $AES0 $AES1 $AES2 $AES3 ]
+			}
+		]
+	}
+}
+
+<confdir:pcm/iec958.conf>
+
+axg-sound-card.pcm.iec958.0 {
+	@args [ CARD AES0 AES1 AES2 AES3 ]
+	@args.CARD { type string }
+	@args.AES0 { type integer }
+	@args.AES1 { type integer }
+	@args.AES2 { type integer }
+	@args.AES3 { type integer }
+	type empty
+	slave.pcm {
+		@func refer
+		name {
+			@func concat
+			strings [
+				"cards.axg-sound-card.pcm.spdif_leg"
+				":CARD=" $CARD
+				",AES0=" $AES0 ",AES1=" $AES1
+				",AES2=" $AES2 ",AES3=" $AES3
+			]
+		}
+	}
+	hint.device 1
+}
